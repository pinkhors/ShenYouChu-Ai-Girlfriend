{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "rootDir": ".",
    "outDir": "out-tsc"
  },
  "include": [
    "tests/**/*.ts",
    "src/renderer/src/api/sse.ts",
    "src/renderer/src/api/encoding.ts",
    "src/renderer/src/api/turnStream.ts",
    "src/renderer/src/chat/pendingMessages.ts",
    "src/renderer/src/chat/pendingHandoff.ts",
    "src/renderer/src/chat/messagePages.ts",
    "src/renderer/src/auth/tokenStore.ts",
    "src/renderer/src/avatar/avatarConfig.ts",
    "src/renderer/src/avatar/avatarStorage.ts",
    "src/renderer/src/portrait/expression.ts",
    "src/renderer/src/portrait/avatarSource.ts",
    "src/renderer/src/portrait/generationConfig.ts",
    "src/renderer/src/voice/voiceConfig.ts",
    "src/main/imagegen.ts",
    "src/main/tts.ts",
    "src/main/asr.ts"
  ]
}