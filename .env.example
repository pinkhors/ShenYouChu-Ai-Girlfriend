# ShenYouChu AI Girlfriend - 本地开发环境变量示例
#
# 使用方法：
#   cp .env.example .env        # Windows PowerShell: Copy-Item .env.example .env
#   docker compose up -d
#
# 注意：
#   - .env 只用于本地，禁止提交到 Git。
#   - 以下默认值仅用于开发；生产环境必须使用强随机口令并通过密钥管理注入。

# MySQL
MYSQL_ROOT_PASSWORD=syc_dev_root
MYSQL_DATABASE=shenyouchu
MYSQL_USER=shenyouchu
MYSQL_PASSWORD=syc_dev_pass
MYSQL_PORT=43306

# Redis
REDIS_PASSWORD=syc_dev_redis
REDIS_PORT=46379

# MinIO（同时作为 Milvus 的后端存储）
MINIO_ROOT_USER=sycminio
MINIO_ROOT_PASSWORD=syc_dev_minio
MINIO_API_PORT=49000
MINIO_CONSOLE_PORT=49001

# Milvus
MILVUS_PORT=49530
MILVUS_METRICS_PORT=49091

# Core 服务（应用启动时使用，Compose 本身不需要）
SERVER_PORT=8080
MYSQL_URL=jdbc:mysql://127.0.0.1:43306/shenyouchu?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
MYSQL_POOL_SIZE=10
AUTH_SESSION_TTL=30d
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# 模型与业务配置（应用启动时使用，Compose 本身不需要）
# 具体模型 ID 以账号实际可用性为准，禁止在代码中硬编码。
# ---------------------------------------------------------------------------
# LLM_PROVIDER=dashscope
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=qwen3.7-plus
# LLM_MODEL_FAST=qwen3.7-flash
# ASR_MODEL=paraformer-realtime-v2
# TTS_MODEL=cosyvoice-v3-flash
# EMBEDDING_MODEL=text-embedding-v4
