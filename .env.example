# ShenYouChu AI Girlfriend - 本地开发环境变量示例
#
# 使用方法：
#   cp .env.example .env        # Windows PowerShell: Copy-Item .env.example .env
#   docker compose up -d
#
# 注意：
#   - .env 只用于本地，禁止提交到 Git。
#   - 以下默认值仅用于开发；生产环境必须使用强随机口令并通过密钥管理注入。

# MySQL
MYSQL_ROOT_PASSWORD=syc_dev_root
MYSQL_DATABASE=shenyouchu
MYSQL_USER=shenyouchu
MYSQL_PASSWORD=syc_dev_pass
MYSQL_PORT=43306

# Redis
REDIS_PASSWORD=syc_dev_redis
REDIS_PORT=46379
REDIS_HOST=127.0.0.1
# true 时账号删除会清理 Redis 会话/临时键；本地默认关闭，接入后打开
REDIS_ENABLED=false

# S3 兼容对象存储（full profile 使用；本地为 legacy MinIO，生产用阿里云 OSS / MinIO / S3）
S3_ACCESS_KEY=sycminio
S3_SECRET_KEY=syc_dev_minio
S3_API_PORT=49000
S3_CONSOLE_PORT=49001

# 应用侧对象存储适配器（本地用 legacy MinIO，生产可切 OSS；密钥只放服务端）
STORAGE_PROVIDER=minio
# true 时账号删除会按 users/{userId}/ 前缀清理对象存储
STORAGE_ENABLED=false
STORAGE_ENDPOINT=http://127.0.0.1:49000
STORAGE_BUCKET=shenyouchu
STORAGE_ACCESS_KEY=sycminio
STORAGE_SECRET_KEY=syc_dev_minio

# 阿里云 OSS 示例（S3 兼容模式，按官方文档核验支持的操作后启用）
# STORAGE_PROVIDER=oss
# STORAGE_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# STORAGE_INTERNAL_ENDPOINT=https://oss-cn-hangzhou-internal.aliyuncs.com
# STORAGE_BUCKET=your-bucket
# STORAGE_ACCESS_KEY=<RAM 子账号 AccessKeyId>
# STORAGE_SECRET_KEY=<RAM 子账号 AccessKeySecret>

# Milvus
MILVUS_PORT=49530
MILVUS_METRICS_PORT=49091

# Core 服务（应用启动时使用，Compose 本身不需要）
SERVER_PORT=48080
MYSQL_URL=jdbc:mysql://127.0.0.1:43306/shenyouchu?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
MYSQL_POOL_SIZE=10
AUTH_SESSION_TTL=30d
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 雪花 ID 实例标识（见 docs/adr/0005-snowflake-ids.md）
# 本地开发默认 1/1 仅适用于单实例；分布式部署必须保证每个实例的
# worker + datacenter 组合唯一，否则会生成重复主键。worker/datacenter 取值 0-31。
SNOWFLAKE_WORKER_ID=1
SNOWFLAKE_DATACENTER_ID=1

# ---------------------------------------------------------------------------
# 模型与业务配置（应用启动时使用，Compose 本身不需要）
# 具体模型 ID 以账号实际可用性为准，禁止在代码中硬编码。
#
# 优先级：用户在桌面端「设置 → 模型（LLM）」保存的配置 > 这里的 LLM_* > 确定性占位回复。
# 因此下面的 LLM_* 只是“用户未保存自己的配置时的兜底”：用户填了自己的
# Base URL / 模型 / Key 并保存后，这里的值不再影响该用户（即使 LLM_ENABLED=false，
# 用户自己的配置仍然优先）。用户可在设置页保存、测试连接或「恢复服务端默认」。
#
# 注意：本文件只被 docker compose 读取；用 mvn / IDEA 启动 core 时不会自动加载它。
# 请把下面变量设置到启动 core 的进程环境变量里（见 docs/05 第一节）。
# ---------------------------------------------------------------------------
# 兜底开关：false 时对“没有保存过配置”的用户使用确定性占位回复；
# 开启后走 OpenAI 兼容接口，失败自动回退。用户自己的开关优先于这里。
LLM_ENABLED=false
# DeepSeek 示例：https://api.deepseek.com/v1 + deepseek-chat
# DashScope 示例：https://dashscope.aliyuncs.com/compatible-mode/v1 + qwen-plus
# OpenAI 示例：https://api.openai.com/v1 + gpt-4o-mini
# 本地 Ollama 示例：http://127.0.0.1:11434/v1 + qwen2.5:7b（Key 可填任意非空值）
LLM_BASE_URL=
# 仅作兜底；用户级 Key 存在服务端 MySQL，接口只回显 hasApiKey，不回显明文。
LLM_API_KEY=
LLM_MODEL=qwen3.7-plus
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=256
LLM_TEMPERATURE=0.8
# LLM_MODEL_FAST=qwen3.7-flash
# ASR_MODEL=paraformer-realtime-v2
# TTS_MODEL=cosyvoice-v3-flash

# 语音服务（VOICE_ENABLED=true 时启用；服务不可用会自动回退占位实现）
VOICE_ENABLED=false
# 外部 ASR 服务：POST JSON { audioBase64, contentType } -> { text, confidence }
VOICE_ASR_URL=
# 外部 TTS 服务：POST JSON { text, emotion } -> { audioBase64, format }
VOICE_TTS_URL=
VOICE_TIMEOUT_SECONDS=30
# EMBEDDING_MODEL=text-embedding-v4
